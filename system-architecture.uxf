<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <help_text>ECEN 4273 Project 2: system architecture (class diagram). Offline, academic use only. Open with UMLet 14.3+ or umletino.com.</help_text>
  <element>
    <id>UMLPackage</id>
    <coordinates><x>20</x><y>20</y><w>250</w><h>340</h></coordinates>
    <panel_attributes>gui.py
fontsize=13</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>30</x><y>60</y><w>230</w><h>220</h></coordinates>
    <panel_attributes>CaptchaApp
--
+env: CaptchaEnv
+challenge: Challenge
+selected_tiles: set[int]
+score_attempts: int
+score_correct: int
--
+load_challenge()
+toggle_tile_selection(i)
+submit(): GradeResult
+run()</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
